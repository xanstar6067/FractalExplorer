<Window x:Class="FractalExplorerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер фракталов - WPF"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Icons/FractalExplorer.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#171A21"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#20242D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3B4250"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F4F8"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#B8C0CC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12" Padding="10"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="5,3,5,12"
                           FontSize="18" FontWeight="SemiBold"
                           Text="Каталог фракталов"/>
                <TreeView x:Name="FractalTree"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectedItemChanged="FractalTree_OnSelectedItemChanged"
                          MouseDoubleClick="FractalTree_OnMouseDoubleClick"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="0,12,12,12" Padding="20"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FractalName" Margin="0,0,0,16"
                           FontSize="25" FontWeight="SemiBold"
                           Text="Выберите фрактал"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#101218"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <Image x:Name="FractalPreview" Margin="6" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,5"
                                   Foreground="{StaticResource SecondaryText}"
                                   Text="Тип рендера:"/>
                        <ComboBox x:Name="RenderPatternSelector" SelectedIndex="0">
                            <ComboBoxItem Content="Классический (от центра)"/>
                            <ComboBoxItem Content="Построчный"/>
                            <ComboBoxItem Content="Спиральный"/>
                            <ComboBoxItem Content="Случайный"/>
                            <ComboBoxItem Content="Шахматный"/>
                            <ComboBoxItem Content="Диагональный"/>
                            <ComboBoxItem Content="От краев к центру"/>
                            <ComboBoxItem Content="Z-кривая (Мортон)"/>
                        </ComboBox>

                        <TextBlock Margin="0,18,0,5"
                                   Foreground="{StaticResource SecondaryText}"
                                   Text="Тема оформления приложения:"/>
                        <ComboBox IsEnabled="False" SelectedIndex="0">
                            <ComboBoxItem Content="Тёмная (временно фиксирована)"/>
                        </ComboBox>

                        <Button x:Name="LaunchButton"
                                Margin="0,22,0,0" Height="44"
                                IsEnabled="False"
                                Content="Запуск недоступен"
                                Click="LaunchButton_OnClick"
                                FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="FractalDescription"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="15" LineHeight="23"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
