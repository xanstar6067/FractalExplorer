<Window x:Class="FractalExplorerWPF.Views.FlameSavesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Сохранения Flame" Width="800" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12" Background="{DynamicResource Theme.BaseBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Padding="10" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="Сохранённые состояния"/><ListBox x:Name="SaveList" Grid.Row="1" Margin="0,8" DisplayMemberPath="SaveName" SelectionChanged="SaveList_OnSelectionChanged"/><StackPanel Grid.Row="2"><TextBox x:Name="NameBox"/><UniformGrid Columns="2"><Button Content="Сохранить" Click="Save_OnClick"/><Button Content="Удалить" Click="Delete_OnClick"/></UniformGrid></StackPanel></Grid></Border>
        <Border Grid.Column="1" Margin="10,0,0,0" Padding="12" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="Black" CornerRadius="5" ClipToBounds="True"><Image x:Name="Preview" Stretch="Uniform"/></Border><TextBlock x:Name="Details" Grid.Row="1" Margin="0,10" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/><Button Grid.Row="2" HorizontalAlignment="Right" Width="130" Content="Загрузить" Click="Load_OnClick"/></Grid></Border>
    </Grid>
</Window>
