<Window x:Class="FractalExplorerWPF.Views.DynamicPaletteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Менеджер палитр" Width="720" Height="470" MinWidth="620" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Bottom"><Button Content="Создать копию" Click="Clone_OnClick"/><Button Content="Удалить" Click="Delete_OnClick"/></StackPanel><ListBox x:Name="PaletteList" DisplayMemberPath="Name" SelectionChanged="PaletteList_OnSelectionChanged"/></DockPanel>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Название"/><TextBox x:Name="NameBox" Grid.Column="1"/></Grid>
            <Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Режим"/><ComboBox x:Name="ModeBox" Grid.Column="1" ItemsSource="{Binding}"/></Grid>
            <Grid Grid.Row="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Диапазон λ"/><TextBox x:Name="RangeBox" Grid.Column="1"/></Grid>
            <Grid Grid.Row="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Полоса нуля"/><TextBox x:Name="ZeroBox" Grid.Column="1"/></Grid>
            <StackPanel Grid.Row="4" Margin="0,9,0,0"><TextBlock Text="Цвета (#AARRGGBB, через запятую)"/><TextBox x:Name="ColorsBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="100"/><Border x:Name="Preview" Height="42" Margin="0,8,0,0" CornerRadius="4"/></StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Применить" Click="Apply_OnClick"/><Button Content="Готово" IsDefault="True" Click="Done_OnClick"/><Button Content="Отмена" IsCancel="True"/></StackPanel>
        </Grid>
    </Grid>
</Window>
