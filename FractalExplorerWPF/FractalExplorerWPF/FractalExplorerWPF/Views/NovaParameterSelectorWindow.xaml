<Window x:Class="FractalExplorerWPF.Views.NovaParameterSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming" xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Title="Выбор точки C — Nova Mandelbrot" Width="820" Height="700" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Closing="Window_OnClosing">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                   Text="ЛКМ: выбрать C. СКМ: перемещение. Колесо: масштаб. Красная рамка — допустимая область."/>
        <Border x:Name="CanvasHost" Grid.Row="1" Background="Black" ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="6" theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp"
                MouseDown="CanvasHost_OnMouseDown" MouseMove="CanvasHost_OnMouseMove" MouseUp="CanvasHost_OnMouseUp">
            <Grid><Grid ClipToBounds="True"><Image x:Name="StableImage" Stretch="Fill"/><Image x:Name="CurrentImage" Stretch="Fill"/></Grid>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/><Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/></Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
            <Button Grid.Column="1" Width="100" Content="Закрыть" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
