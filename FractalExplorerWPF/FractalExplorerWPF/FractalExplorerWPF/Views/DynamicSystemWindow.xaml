<Window x:Class="FractalExplorerWPF.Views.DynamicSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Width="1120" Height="700" MinWidth="900" MinHeight="560"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <DrawingBrush x:Key="TransparencyBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF303030"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#FF454545"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8"/><RectangleGeometry Rect="8,8,8,8"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ControlsHost" Grid.Column="0" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Text="Параметры"/>
                    <StackPanel x:Name="ParameterPanel" Margin="0,10,0,0"/>

                    <Button x:Name="PaletteButton" Content="Настроить палитру"
                            Visibility="Collapsed" Click="Palette_OnClick"/>

                    <Grid x:Name="FractalColorPanel" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <Button Content="Цвет фрактала" Click="FractalColor_OnClick"/>
                        <Border x:Name="FractalColorSwatch" Grid.Column="1" Margin="6"
                                CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                MouseLeftButtonDown="FractalColor_OnClick"/>
                    </Grid>
                    <Grid x:Name="BackgroundColorPanel">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <Button Content="Цвет фона" Click="BackgroundColor_OnClick"/>
                        <Border x:Name="BackgroundColorSwatch" Grid.Column="1" Margin="6"
                                CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                MouseLeftButtonDown="BackgroundColor_OnClick"/>
                    </Grid>

                    <Button Content="Запустить рендер" Click="Render_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/>
                    <Button Content="Сбросить вид" Click="Reset_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                    <Button Content="Сохранить изображение" Click="Export_OnClick"/>

                    <TextBlock x:Name="ProgressText" Margin="0,12,0,4"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/>
                    <ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/>
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.DisabledTextBrush}"
                               Text="Колесо мыши: масштаб. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10"
                Background="{StaticResource TransparencyBrush}" ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid x:Name="CanvasSurface">
                <Grid x:Name="ImageLayer">
                    <Image x:Name="StableImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="CurrentImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/>
                <Border x:Name="RenderBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Padding="10,6" CornerRadius="5" Background="#B0000000" Visibility="Collapsed">
                    <TextBlock x:Name="RenderBadgeText" Foreground="White"/>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
