<Window x:Class="FractalExplorerWPF.Views.DynamicSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming" Width="1180" Height="760" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <DrawingBrush x:Key="TransparencyBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#FF303030"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FF454545"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8"/><RectangleGeometry Rect="8,8,8,8"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel x:Name="ParameterPanel"/>
                <StackPanel x:Name="PalettePanel" Visibility="Collapsed"><TextBlock Margin="0,8,0,3" Text="Палитра"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PaletteBox" SelectionChanged="PaletteBox_OnSelectionChanged"/><Button Grid.Column="1" Margin="6,0,0,0" Content="Изменить…" Click="Palette_OnClick"/></Grid></StackPanel>
                <Grid x:Name="FractalColorPanel" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Цвет фрактала" Click="FractalColor_OnClick"/><Border x:Name="FractalColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="FractalColor_OnClick"/></Grid>
                <Grid x:Name="BackgroundColorPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Цвет фона" Click="BackgroundColor_OnClick"/><Border x:Name="BackgroundColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="BackgroundColor_OnClick"/></Grid>
                <WrapPanel Margin="0,8,0,0"><Button Content="Рендер" Click="Render_OnClick"/><Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/><Button Content="Сброс вида" Click="Reset_OnClick"/></WrapPanel>
                <Button Content="Менеджер сохранений" Click="Saves_OnClick"/><Button Content="Экспорт изображения" Click="Export_OnClick"/>
                <TextBlock x:Name="ProgressText" Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/><ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Колесо: масштаб. ЛКМ: перемещение. F11: полный экран."/>
            </StackPanel></ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="{StaticResource TransparencyBrush}" ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid><Image x:Name="StableImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/><Image x:Name="CurrentImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/><Border x:Name="RenderBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" Visibility="Collapsed"><TextBlock x:Name="RenderBadgeText" Foreground="White"/></Border></Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Width="38" Height="38" Margin="12" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10" Content="✕" Click="Toggle_OnClick"/>
    </Grid>
</Window>
