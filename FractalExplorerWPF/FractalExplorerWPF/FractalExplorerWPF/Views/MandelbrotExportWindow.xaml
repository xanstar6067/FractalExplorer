<Window x:Class="FractalExplorerWPF.Views.MandelbrotExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер сохранения изображений" Width="520" Height="650"
        MinWidth="480" MinHeight="570" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Save.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Параметры изображения"/>

                <GroupBox Margin="0,14,0,0" Padding="10" Header="Параметры вывода">
                    <StackPanel>
                        <TextBlock Text="Разрешение изображения"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthBox" Grid.Column="0" Padding="7"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="×"/>
                            <TextBox x:Name="HeightBox" Grid.Column="2" Padding="7"/>
                            <Button Grid.Column="3" Margin="8,0,0,0" Padding="13,5" Content="Повернуть"
                                    Click="Rotate_OnClick"/>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Button Margin="2" Content="HD 720p" Tag="1280,720" Click="Preset_OnClick"/>
                            <Button Margin="2" Content="Full HD" Tag="1920,1080" Click="Preset_OnClick"/>
                            <Button Margin="2" Content="2K" Tag="2560,1440" Click="Preset_OnClick"/>
                            <Button Margin="2" Content="4K" Tag="3840,2160" Click="Preset_OnClick"/>
                            <Button Margin="2" Content="8K" Tag="7680,4320" Click="Preset_OnClick"/>
                        </UniformGrid>

                        <TextBlock Margin="0,10,0,3" Text="Формат файла"/>
                        <ComboBox x:Name="FormatBox" SelectedIndex="0" SelectionChanged="FormatBox_OnSelectionChanged">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="BMP"/>
                        </ComboBox>

                        <StackPanel x:Name="JpegQualityPanel" Margin="0,9,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock Text="Качество JPG"/>
                                <TextBlock x:Name="JpegQualityValue" DockPanel.Dock="Right" Text="95%"/>
                            </DockPanel>
                            <Slider x:Name="JpegQualitySlider" Minimum="1" Maximum="100" Value="95"
                                    TickFrequency="1" ValueChanged="JpegQualitySlider_OnValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Padding="10" Header="Эффекты и качество">
                    <StackPanel>
                        <TextBlock Text="Режим обработки"/>
                        <ComboBox x:Name="ProcessingModeBox" SelectedIndex="0"
                                  SelectionChanged="ProcessingModeBox_OnSelectionChanged">
                            <ComboBoxItem Content="SSAA"/>
                            <ComboBoxItem Content="Бикубический апскейл"/>
                            <ComboBoxItem Content="Ланцош 3"/>
                        </ComboBox>
                        <TextBlock x:Name="QualityFactorLabel" Margin="0,8,0,3" Text="Сглаживание (SSAA)"/>
                        <ComboBox x:Name="QualityFactorBox"/>
                        <TextBlock x:Name="QualityHint" Margin="0,8,0,0" Foreground="#777" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MemoryHint" VerticalAlignment="Center" Foreground="#777" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="105" Margin="4" Content="Экспорт" IsDefault="True" Click="Accept_OnClick"/>
                <Button Width="105" Margin="4" Content="Отмена" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
