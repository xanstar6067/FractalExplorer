<Window x:Class="FractalExplorerWPF.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Title="Выбор цвета" Width="850" Height="590" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:ColorPickerPanel x:Name="Picker"/>
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,8,0" Content="ОК" IsDefault="True" Click="Ok_OnClick"/>
            <Button Width="100" Content="Отмена" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
