<Window x:Class="FractalExplorerWPF.Views.FlameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Фрактальное пламя" Width="1160" Height="740" MinWidth="920" MinHeight="590" WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Параметры Flame"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Сэмплы"/><TextBox x:Name="SamplesBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Итераций/сэмпл"/><TextBox x:Name="IterationsBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Прогрев"/><TextBox x:Name="WarmupBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Масштаб"/><TextBox x:Name="ScaleBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр X"/><TextBox x:Name="CenterXBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр Y"/><TextBox x:Name="CenterYBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Экспозиция"/><TextBox x:Name="ExposureBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Гамма"/><TextBox x:Name="GammaBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <TextBlock Margin="0,4,0,0" Text="Потоки ЦП"/><ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                <CheckBox x:Name="CoverageCheck" Margin="0,9,0,5" IsChecked="True" Content="Показывать карту покрытия" Checked="Coverage_OnChanged" Unchecked="Coverage_OnChanged"/>
                <Button Content="Трансформации" Click="Transforms_OnClick"/><Button Content="Запустить рендер" Click="Render_OnClick"/><Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/>
                <Button Content="Менеджер сохранений" Click="Saves_OnClick"/><Button Content="Сохранить изображение" Click="Export_OnClick"/>
                <TextBlock x:Name="ProgressText" Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Ожидание"/><ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.DisabledTextBrush}" Text="Колесо: масштаб. ЛКМ: перемещение. Карта покрытия показывает накопление стохастических траекторий."/>
            </StackPanel></ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid><Image x:Name="StableImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/><Image x:Name="CoverageImage" Stretch="Fill" Opacity="0.42"/>
                <Border x:Name="RenderBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" Visibility="Collapsed"><TextBlock x:Name="RenderBadgeText" Foreground="White"/></Border></Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
