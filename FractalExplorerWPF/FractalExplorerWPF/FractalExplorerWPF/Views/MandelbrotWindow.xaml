<Window x:Class="FractalExplorerWPF.Views.MandelbrotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="760" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/FractalExplorer.ico"
        KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#171A21"/>
        <SolidColorBrush x:Key="PanelBg" Color="#20242D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3B4250"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F4F8"/></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="29"/><Setter Property="Margin" Value="0,2,0,7"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,2,0,7"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F4F8"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Expander"><Setter Property="Foreground" Value="#F2F4F8"/><Setter Property="Margin" Value="0,5,0,3"/></Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="278"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10" Padding="14" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <TextBlock Margin="0,14,0,0" Text="Итерации"/>
                    <TextBox x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Порог выхода"/>
                    <TextBox x:Name="ThresholdBox" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Приближение"/>
                    <TextBox x:Name="ZoomBox" TextChanged="ZoomBox_OnTextChanged"/>

                    <StackPanel x:Name="PowerPanel">
                        <TextBlock Text="Степень"/>
                        <TextBox x:Name="PowerBox" TextChanged="Parameter_OnChanged"/>
                    </StackPanel>
                    <CheckBox x:Name="InversionBox" Content="Инверсия по горизонтали"
                              Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>

                    <TextBlock Text="Потоки ЦП"/>
                    <ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="PreviewSsaaBox" SelectedIndex="0" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="1×" Tag="1"/>
                        <ComboBoxItem Content="2×" Tag="2"/>
                        <ComboBoxItem Content="3×" Tag="3"/>
                        <ComboBoxItem Content="4×" Tag="4"/>
                    </ComboBox>
                    <TextBlock Text="Окрашивание"/>
                    <ComboBox x:Name="ColoringModeBox" SelectionChanged="ColoringMode_OnChanged">
                        <ComboBoxItem Content="Дискретное" Tag="Discrete"/>
                        <ComboBoxItem Content="Плавное" Tag="Smooth"/>
                        <ComboBoxItem Content="Гистограмма" Tag="Histogram"/>
                        <ComboBoxItem Content="Орбитальная ловушка" Tag="OrbitTrap"/>
                        <ComboBoxItem Content="Полосатое усреднение" Tag="StripeAverage"/>
                        <ComboBoxItem Content="Smooth Escape (Poly)" Tag="SmoothEscapePolynomial"/>
                    </ComboBox>

                    <Expander Header="Параметры окрашивания">
                        <StackPanel Margin="12,6,0,4">
                            <TextBlock Text="Контраст гистограммы"/>
                            <TextBox x:Name="HistogramContrastBox" TextChanged="Parameter_OnChanged"/>
                            <TextBlock Text="Сила / смещение ловушки"/>
                            <UniformGrid Columns="2"><TextBox x:Name="OrbitStrengthBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="OrbitBiasBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Частота / сила / смещение полос" TextWrapping="Wrap"/>
                            <UniformGrid Columns="3"><TextBox x:Name="StripeFrequencyBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="StripeStrengthBox" Margin="3,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="StripeBiasBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Полином A / B / C"/>
                            <UniformGrid Columns="3"><TextBox x:Name="PolyABox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="PolyBBox" Margin="3,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="PolyCBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Gamma / blend / bias"/>
                            <UniformGrid Columns="3"><TextBox x:Name="PolyGammaBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="PolyBlendBox" Margin="3,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox x:Name="PolyBiasBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                        </StackPanel>
                    </Expander>

                    <Button Content="Настроить палитру" Click="PaletteButton_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>
                    <UniformGrid Columns="2">
                        <Button Margin="0,3,3,3" Content="Сбросить вид" Click="ResetButton_OnClick"/>
                        <Button Margin="3,3,0,3" Content="Рендер" Click="RenderButton_OnClick"/>
                    </UniformGrid>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>

                    <TextBlock Margin="0,10,0,4" Foreground="#B8C0CC" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#B8C0CC" TextWrapping="Wrap" Text="Готово"/>
                    <TextBlock Margin="0,14,0,0" Foreground="#8F98A6" TextWrapping="Wrap"
                               Text="Колесо мыши: масштаб. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove"
                MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True"/>
        </Border>
    </Grid>
</Window>
