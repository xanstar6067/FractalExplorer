<Window x:Class="FractalExplorerWPF.Views.MandelbrotPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Палитры семейства Мандельброта" Width="780" Height="520"
        MinWidth="680" MinHeight="440" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Color.ico">
    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox x:Name="PaletteList" SelectionChanged="PaletteList_OnSelectionChanged"/>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
                <Button Margin="2" Content="Новая" Click="New_OnClick"/>
                <Button Margin="2" Content="Копия" Click="Copy_OnClick"/>
                <Button Margin="2" Content="Удалить" Click="Delete_OnClick"/>
            </UniformGrid>
        </Grid>
        <StackPanel Grid.Column="2">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Редактор палитры"/>
            <TextBlock Margin="0,14,0,3" Text="Название"/><TextBox x:Name="NameBox" Padding="7"/>
            <TextBlock Margin="0,12,0,3" Text="Цвета градиента (#AARRGGBB через ; )"/>
            <TextBox x:Name="ColorsBox" Padding="7" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="ColorsBox_OnTextChanged"/>
            <Border x:Name="GradientPreview" Height="34" Margin="0,7,0,9" BorderBrush="#777" BorderThickness="1"/>
            <TextBlock Text="Цвет внутренней области (#AARRGGBB)"/>
            <TextBox x:Name="InteriorColorBox" Padding="7" TextChanged="ColorsBox_OnTextChanged"/>
            <CheckBox x:Name="GradientBox" Margin="0,8,0,6" Content="Плавный градиент"/>
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,6,0"><TextBlock Text="Гамма"/><TextBox x:Name="GammaBox" Padding="7"/></StackPanel>
                <StackPanel Margin="6,0,0,0"><TextBlock Text="Период цвета"/><TextBox x:Name="PeriodBox" Padding="7"/></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="EditHint" Margin="0,8,0,0" Foreground="#777" TextWrapping="Wrap"/>
            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="100" Margin="4" Content="Сохранить" Click="Save_OnClick"/>
                <Button Width="100" Margin="4" Content="Применить" Click="Apply_OnClick"/>
                <Button Width="100" Margin="4" Content="Закрыть" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
