<Window x:Class="FractalExplorerWPF.Views.PhoenixParameterSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming" Title="Выбор параметров Phoenix C1/C2"
        Width="1040" Height="700" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Phoenix.ico" Closing="Window_OnClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Исследователь параметров Феникса"/>
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="ЛКМ выбирает значение на срезе. Колесо масштабирует, средняя кнопка перемещает карту."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="P = Re(C1)"/><TextBox x:Name="PBox" Padding="7" TextChanged="ParameterText_OnChanged"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="5,0"><TextBlock Text="Q = Im(C1)"/><TextBox x:Name="QBox" Padding="7" TextChanged="ParameterText_OnChanged"/></StackPanel>
            <CheckBox x:Name="AdvancedBox" Grid.Column="3" Margin="12,20,0,0" VerticalAlignment="Top" Content="Расширенный режим" Checked="AdvancedBox_OnChanged" Unchecked="AdvancedBox_OnChanged"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Срез P — Re(C1)">
                <Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PFixedText" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <Border x:Name="PSliceHost" Grid.Row="1" Tag="P" Margin="0,6" Background="Black" BorderBrush="{DynamicResource Theme.InteractiveBorderBrush}"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True" theme:ThemeContract.IgnoreAudit="True"
                            SizeChanged="SliceHost_OnSizeChanged" MouseWheel="SliceHost_OnMouseWheel" MouseLeftButtonUp="SliceHost_OnMouseLeftButtonUp"
                            MouseDown="SliceHost_OnMouseDown" MouseMove="SliceHost_OnMouseMove" MouseUp="SliceHost_OnMouseUp">
                        <Grid><Image x:Name="PSliceImage" Stretch="Fill"/><Canvas x:Name="PMarkerLayer" IsHitTestVisible="False">
                            <Line x:Name="PMarkerHorizontal" Stroke="LimeGreen" StrokeThickness="1.5"/><Line x:Name="PMarkerVertical" Stroke="LimeGreen" StrokeThickness="1.5"/>
                        </Canvas></Grid>
                    </Border>
                    <ProgressBar x:Name="PProgress" Grid.Row="2" Height="16" Minimum="0" Maximum="100"/>
                    <StackPanel x:Name="PAdvancedPanel" Grid.Row="3" Margin="0,7,0,0"><TextBlock Text="Служебная координата Im(z0)"/><TextBox x:Name="PServiceBox" Padding="7" TextChanged="ParameterText_OnChanged"/></StackPanel>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Срез Q — Im(C1)">
                <Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="QFixedText" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <Border x:Name="QSliceHost" Grid.Row="1" Tag="Q" Margin="0,6" Background="Black" BorderBrush="{DynamicResource Theme.InteractiveBorderBrush}"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True" theme:ThemeContract.IgnoreAudit="True"
                            SizeChanged="SliceHost_OnSizeChanged" MouseWheel="SliceHost_OnMouseWheel" MouseLeftButtonUp="SliceHost_OnMouseLeftButtonUp"
                            MouseDown="SliceHost_OnMouseDown" MouseMove="SliceHost_OnMouseMove" MouseUp="SliceHost_OnMouseUp">
                        <Grid><Image x:Name="QSliceImage" Stretch="Fill"/><Canvas x:Name="QMarkerLayer" IsHitTestVisible="False">
                            <Line x:Name="QMarkerHorizontal" Stroke="LimeGreen" StrokeThickness="1.5"/><Line x:Name="QMarkerVertical" Stroke="LimeGreen" StrokeThickness="1.5"/>
                        </Canvas></Grid>
                    </Border>
                    <ProgressBar x:Name="QProgress" Grid.Row="2" Height="16" Minimum="0" Maximum="100"/>
                    <StackPanel x:Name="QAdvancedPanel" Grid.Row="3" Margin="0,7,0,0"><TextBlock Text="Служебная координата Im(z0)"/><TextBox x:Name="QServiceBox" Padding="7" TextChanged="ParameterText_OnChanged"/></StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="FixedC2Text"/><TextBlock x:Name="StatusText" Margin="0,3,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Width="110" Margin="4" Content="Сбросить вид" Click="Reset_OnClick"/>
                <Button Width="110" Margin="4" Content="Применить" IsDefault="True" Click="Apply_OnClick"/><Button Width="110" Margin="4" Content="Отмена" IsCancel="True"/></StackPanel>
        </Grid>
    </Grid>
</Window>
