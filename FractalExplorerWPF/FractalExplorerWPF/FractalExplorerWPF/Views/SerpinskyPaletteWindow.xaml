<Window x:Class="FractalExplorerWPF.Views.SerpinskyPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Палитры Серпинского"
        Width="720" Height="470"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Color.ico">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="PaletteList"
                     SelectionChanged="PaletteList_OnSelectionChanged"/>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
                <Button Margin="2" Content="Новая" Click="New_OnClick"/>
                <Button Margin="2" Content="Копия" Click="Copy_OnClick"/>
                <Button Margin="2" Content="Удалить" Click="Delete_OnClick"/>
            </UniformGrid>
        </Grid>

        <StackPanel Grid.Column="2">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Редактор"/>
            <TextBlock Margin="0,16,0,3" Text="Название"/>
            <TextBox x:Name="NameBox" Padding="7"/>

            <TextBlock Margin="0,14,0,3" Text="Цвет фрактала (#AARRGGBB)"/>
            <DockPanel>
                <Border x:Name="FractalColorPreview" Width="48" Margin="0,0,8,0" CornerRadius="4"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" theme:ThemeContract.IgnoreAudit="True"/>
                <TextBox x:Name="FractalColorBox" Padding="7"
                         TextChanged="ColorBox_OnTextChanged"/>
            </DockPanel>

            <TextBlock Margin="0,14,0,3" Text="Цвет фона (#AARRGGBB)"/>
            <DockPanel>
                <Border x:Name="BackgroundColorPreview" Width="48" Margin="0,0,8,0" CornerRadius="4"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" theme:ThemeContract.IgnoreAudit="True"/>
                <TextBox x:Name="BackgroundColorBox" Padding="7"
                         TextChanged="ColorBox_OnTextChanged"/>
            </DockPanel>

            <TextBlock x:Name="EditHint" Margin="0,14,0,0"
                       Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>

            <StackPanel Margin="0,28,0,0" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="100" Margin="4" Content="Сохранить" Click="Save_OnClick"/>
                <Button Width="100" Margin="4" Content="Применить" Click="Apply_OnClick"/>
                <Button Width="100" Margin="4" Content="Закрыть" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
