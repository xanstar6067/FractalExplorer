<Window x:Class="perturbation_theory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мандельброт · Perturbation theory"
        Width="1180" Height="820" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" Icon="Assets/Icons/PerturbationTheory.ico"
        Loaded="Window_OnLoaded" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <!-- Simplified copy of the main WPF Views/MandelbrotWindow.xaml. -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="29"/><Setter Property="Margin" Value="0,2,0,7"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,2,0,7"/>
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Margin" Value="0,5,0,3"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ParametersColumn" Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="ParametersBorder" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Множество Мандельброта" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Сравнение движков · z² + c" Margin="0,4,0,14" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock Text="Движок"/>
                    <ComboBox x:Name="EngineBox" SelectedIndex="0" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Perturbation"/>
                        <ComboBoxItem Content="Классический (из WPF)"/>
                    </ComboBox>
                    <TextBlock x:Name="PrecisionLabel" Text="Опорная орбита → отклонения"/>
                    <ComboBox x:Name="PrecisionBox" SelectedIndex="1" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="double → double"/>
                        <ComboBoxItem Content="decimal → double"/>
                        <ComboBoxItem Content="decimal → decimal"/>
                    </ComboBox>
                    <TextBlock x:Name="PrecisionHint" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock Text="Итерации"/>
                    <TextBox x:Name="IterationsBox" Text="500" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Порог выхода |z|"/>
                    <TextBox x:Name="ThresholdBox" Text="2" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Приближение"/>
                    <TextBox x:Name="ZoomBox" Text="0.75" TextChanged="View_OnChanged"/>
                    <Expander Header="Координаты центра" IsExpanded="False">
                        <StackPanel Margin="8,6,0,4">
                            <TextBlock Text="Действительная часть"/>
                            <TextBox x:Name="CenterXBox" Text="-0.5" TextChanged="View_OnChanged" FontSize="11"/>
                            <TextBlock Text="Мнимая часть"/>
                            <TextBox x:Name="CenterYBox" Text="0" TextChanged="View_OnChanged" FontSize="11"/>
                            <TextBlock Text="Можно вводить точку, запятую и экспоненту: 1e18." FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="Потоки ЦП"/>
                    <ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Окрашивание"/>
                    <ComboBox x:Name="ColoringBox" SelectedIndex="1" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Дискретное"/>
                        <ComboBoxItem Content="Плавное"/>
                    </ComboBox>
                    <TextBlock Text="Палитра"/>
                    <ComboBox x:Name="PaletteBox" SelectionChanged="Palette_OnChanged"/>
                    <TextBlock Text="Период палитры"/>
                    <TextBox x:Name="PeriodBox" Text="800" TextChanged="Parameter_OnChanged"
                             ToolTip="Для плавного стандартного серого используется число итераций."/>
                    <UniformGrid Columns="2">
                        <Button Content="Сбросить вид" Margin="0,3,3,3" Click="ResetButton_OnClick"/>
                        <Button Content="Рендер" Margin="3,3,0,3" Click="RenderButton_OnClick"/>
                    </UniformGrid>
                    <Button Content="Пример глубокого зума" Click="DeepZoomButton_OnClick"
                            ToolTip="Долина морских коньков, приближение 1e12, 4000 итераций."/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                    <ProgressBar x:Name="RenderProgress" Height="12" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Готово" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock x:Name="StatisticsText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock Text="Колесо: масштаб у курсора. ЛКМ: перемещение. F11: полный экран. Esc: отмена."
                               TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="1" Margin="0,10,10,10" Background="Black" CornerRadius="7"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
            <Grid x:Name="CanvasHost" Background="Black" ClipToBounds="True" Focusable="True"
                  SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel"
                  MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove"
                  MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp" LostMouseCapture="CanvasHost_OnLostMouseCapture">
                <Grid x:Name="ImageLayer" ClipToBounds="True" IsHitTestVisible="False">
                    <Image x:Name="StablePreviewImage" Stretch="Fill" SnapsToDevicePixels="True"
                           RenderTransformOrigin="0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="7,4"
                        Background="#CC121212" CornerRadius="4" IsHitTestVisible="False">
                    <TextBlock x:Name="CanvasStatusText" Text="Perturbation" Foreground="#DDEDDD" FontSize="11"/>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1" Content="✕"
                Style="{StaticResource FractalPanelToggleButtonStyle}" ToolTip="Скрыть панель параметров"
                Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
